# Copy this file to .env and adjust the values for your environment.
#   cp .env.example .env

# PostgreSQL connection used by the CLI (sec/load commands and health
# scripts). The default matches local development.
DATABASE_URL=postgresql://financial:test@localhost:5432/financial_database

# SEC EDGAR requires a unique, descriptive User-Agent with contact info.
# The SEC ingestion pipeline (sec sync, sync-all, bulk-ingest,
# update-incremental) refuses to run without it. Use the format:
#   ApplicationName/Version your_email@your_domain.com
# NEVER use a github.com address: SEC answers HTTP 403 for the github.com
# address family (including users.noreply.github.com). Evidence and
# workarounds: docs/sec_403_investigation.md
SEC_USER_AGENT="FinancialDataBase/1.0 your-email@example.com"

# Where raw SEC responses (submissions/companyfacts JSON) are cached for
# provenance and re-processing. Defaults to ./data/raw.
DATA_RAW_DIR=./data/raw

# Test database (tests only). The unit/integration suites use these.
# The unit suite does not need any of them; the integration suite targets
# TEST_DB_NAME, so never point it at a database you care about.
TEST_DB_NAME=financial_database_test
TEST_DB_USER=financial
TEST_DB_PASSWORD=test
TEST_DB_HOST=localhost
TEST_DB_PORT=5432

# Optional extras (see pyproject.toml):
#   pip install -e ".[prices]"   # yfinance + pandas, required by the price
#                                # providers and by the price ingestion tests
#   pip install -e ".[dev]"      # pytest, ruff, pyright and the above
#
# Note: raw_documents/raw response caching defaults to DATA_RAW_DIR. Keep
# .env out of version control: it is git-ignored.