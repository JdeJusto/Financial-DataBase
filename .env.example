# Copy this file to .env and adjust the values for your environment.
#   cp .env.example .env

# PostgreSQL connection used by the CLI (sec/load commands and health
# scripts). The default matches local development.
DATABASE_URL=postgresql://financial:test@localhost:5432/financial_database

# SEC EDGAR requires a unique, descriptive User-Agent with contact info.
# The SEC ingestion pipeline (sec sync, sync-all, bulk-ingest,
# update-incremental) refuses to run without it. Use the format:
#   ApplicationName/Version your_email@your_domain.com
SEC_USER_AGENT="YourApp/1.0 you@example.com"

# Where raw SEC responses (submissions/companyfacts JSON) are cached for
# provenance and re-processing. Defaults to ./data/raw.
DATA_RAW_DIR=./data/raw

# Test database (tests only). The unit/integration suites use these.
TEST_DB_NAME=financial_database_test
TEST_DB_USER=financial
TEST_DB_PASSWORD=test
TEST_DB_HOST=localhost
TEST_DB_PORT=5432